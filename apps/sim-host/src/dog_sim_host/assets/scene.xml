<!--
  The world around the dog: floor, home spot, the bone and the person who calls "hier".

  The dog starts at home (the origin) facing +x. The "such" behaviour first turns
  180 degrees, so the bone starts behind the dog.
-->
<mujoco model="dog-world">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <include file="dog.xml"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.32 0.36 0.32" rgb2="0.29 0.33 0.29" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="floor" rgba="0.31 0.35 0.31 1" contype="0" conaffinity="1"/>
    <geom name="home" type="cylinder" size="0.15 0.001" rgba="0.25 0.5 0.95 0.5" contype="0" conaffinity="0"/>

    <body name="bone" pos="-1.2 0.15 0.03">
      <freejoint name="bone"/>
      <!-- The camera detects the "bone" geom; the knobs are decoration. -->
      <geom name="bone" type="box" size="0.05 0.012 0.012" mass="0.05" rgba="0.95 0.9 0.78 1" contype="1" conaffinity="1"/>
      <geom name="bone_knob_1" type="sphere" size="0.018" pos="0.05 0.012 0" rgba="0.95 0.9 0.78 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="bone_knob_2" type="sphere" size="0.018" pos="0.05 -0.012 0" rgba="0.95 0.9 0.78 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="bone_knob_3" type="sphere" size="0.018" pos="-0.05 0.012 0" rgba="0.95 0.9 0.78 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="bone_knob_4" type="sphere" size="0.018" pos="-0.05 -0.012 0" rgba="0.95 0.9 0.78 1" contype="0" conaffinity="0" mass="0"/>
    </body>

    <!-- Mocap: the person does not fall over; the viewer moves it around. Geoms named person_* and shoe_* are detectable. -->
    <body name="person" mocap="true" pos="1.6 -0.4 0">
      <geom name="person_leg_left" type="capsule" fromto="0 0.09 0.08 0 0.09 0.85" size="0.06" rgba="0.2 0.25 0.4 1" contype="0" conaffinity="1"/>
      <geom name="person_leg_right" type="capsule" fromto="0 -0.09 0.08 0 -0.09 0.85" size="0.06" rgba="0.2 0.25 0.4 1" contype="0" conaffinity="1"/>
      <geom name="person_torso" type="box" size="0.11 0.2 0.3" pos="0 0 1.2" rgba="0.75 0.35 0.3 1" contype="0" conaffinity="1"/>
      <geom name="person_head" type="sphere" size="0.11" pos="0 0 1.65" rgba="0.87 0.72 0.6 1" contype="0" conaffinity="1"/>
      <geom name="shoe_left" type="box" size="0.13 0.05 0.04" pos="-0.03 0.09 0.04" rgba="0.12 0.12 0.12 1" contype="0" conaffinity="1"/>
      <geom name="shoe_right" type="box" size="0.13 0.05 0.04" pos="-0.03 -0.09 0.04" rgba="0.12 0.12 0.12 1" contype="0" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>

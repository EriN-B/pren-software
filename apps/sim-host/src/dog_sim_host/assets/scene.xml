<!--
  The world around the dog: floor, home spot, the bone and the person who calls "hier".

  The dog starts at home (the origin) facing +x. The "such" behaviour first turns
  180 degrees, so the bone starts behind the dog.
-->
<mujoco model="dog-world">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <!-- An indoor room for the core's camera: brighter light and a light sky. -->
  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <include file="dog.xml"/>

  <default>
    <!-- Field markings and pylons, generated by scripts/build_field.py. -->
    <default class="tape">
      <!-- White floor tape, 5 cm (photo of the field). -->
      <geom type="box" rgba="0.93 0.9 0.82 1" contype="0" conaffinity="0"/>
    </default>
    <default class="pylon">
      <!-- A small red-orange training cone, about 20 cm high (photo). The dog bumps into it. -->
      <geom type="mesh" mesh="pylon" rgba="1 0.3 0.12 1" contype="0" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <mesh name="pylon" vertex="0.07 0 0  0.0495 0.0495 0  0 0.07 0  -0.0495 0.0495 0  -0.07 0 0  -0.0495 -0.0495 0  0 -0.07 0  0.0495 -0.0495 0  0 0 0.2"/>
    <!-- The competition floor: glossy terracotta tiles, 30 cm, as in photos of the canteen.
         The core's detector needs a surface like this; on a flat colour it never found the
         bone. The texture is made by scripts/make_floor_texture.py and repeats every 0.6 m. -->
    <texture name="floor" type="2d" file="floor.png"/>
    <material name="floor" texture="floor" texrepeat="20 20" reflectance="0.15" specular="0.4" shininess="0.6"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.9 0.9 0.88" rgb2="0.7 0.7 0.68" width="256" height="256"/>
    <!-- The competition bone: white, 21 cm. -->
    <material name="bone" rgba="0.95 0.94 0.9 1" specular="0.3" shininess="0.4"/>
    <!-- Scan of a real bone, scaled to 21 cm by scripts/prepare_bone.py (210 x 74 x 44 mm). -->
    <mesh name="bone" file="meshes/STL/Knochen_sim.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="6 6 0.05" material="floor" contype="0" conaffinity="1"/>
    <!-- Group 4: drawn in the viewer only, not in the dog's camera (not on the real floor). -->
    <geom name="home" type="cylinder" size="0.15 0.001" rgba="0.25 0.5 0.95 0.5" group="4" contype="0" conaffinity="0"/>


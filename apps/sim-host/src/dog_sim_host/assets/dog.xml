<!--
  The dog robot: body and head from the team's flipchart drawing, legs from the CAD parts
  of the leg test setup (meshes in assets/meshes/STL, millimetres).

  Axes: x forwards, y to the dog's left, z up. Units: metres, kilograms, radians.
  Leg parts come from CAD. Torso, head, tail and all masses are still PLACEHOLDERS;
  see docs/simulator/robot-model.md for the list and where each one is used.

  Parts from the drawing:
    torso        box body with emergency stop ("Not") on top and speaker ("Woof!") on the side
    head         pans on "Servo-Kopf"; carries the camera module, ears and the LED matrix
    tail         wags on "Servo-Schwanz"
    4 legs       per leg a four-bar linkage on a mounting plate (Grundkörper): the servo
                 (MG946R) turns the drive strut (Antriebsstütze), the linkage swings on the
                 hip axle, the leg (Bein) joins both and carries the wheel (Rad). The leg
                 stays nearly upright while the servo raises or lowers the body. A tension
                 spring (Zugfeder) between linkage and leg. Generated from the CAD hole
                 positions by apps/sim-host/scripts/build_legs.py.
    front wheels driven by DC motors through the H-bridge, with encoders left/right
    rear wheels  passive, touching the floor as frictionless balls
    sensors      IMU in the torso, ultrasonic sensor on the chest
-->
<mujoco model="dog">
  <default>
    <default class="dog">
      <!-- contype 1 / conaffinity 0: dog parts touch the world, never each other. -->
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.94 0.93 0.9 1"/>
      <joint damping="0.05" armature="0.002"/>

      <default class="visual">
        <!-- Decoration only: no collisions, no mass. -->
        <geom contype="0" conaffinity="0" mass="0"/>
      </default>

      <default class="part">
        <!-- CAD part: drawn from its STL, mass from its volume (3D printed PLA, assumed). -->
        <geom type="mesh" contype="0" conaffinity="0" density="1250" rgba="0.82 0.8 0.76 1"/>
      </default>
      <default class="servo">
        <!-- MG946R: about 13 kg cm = 1.3 Nm stall torque at 6 V. Angle 0 = auf (crank
             40 degrees below horizontal, legs nearly stretched); positive lowers the body.
             Range from the four-bar: beyond it a leg can snap through. -->
        <joint type="hinge" range="-0.6 0.8" damping="0.3"/>
        <position kp="25" forcerange="-1.3 1.3" ctrlrange="-0.6 0.8"/>
      </default>
      <default class="pin">
        <joint type="hinge" axis="0 1 0" damping="0.01"/>
      </default>
      <default class="knee">
        <!-- Stop at 80 degrees so the four-bar cannot snap through into its crossed pose. -->
        <joint type="hinge" axis="0 1 0" damping="0.01" range="-1.4 1.4"/>
      </default>
      <default class="caster">
        <!-- priority makes the frictionless condim win over the floor's. -->
        <geom type="sphere" size="0.02" condim="1" priority="1" mass="0.005" rgba="0 0 0 0"/>
      </default>

      <default class="wheel">
        <joint type="hinge" axis="0 1 0" damping="0.01"/>
        <!-- DC gear motor: target wheel speed in rad/s, torque limited. -->
        <velocity kv="0.3" forcerange="-0.6 0.6" ctrlrange="-30 30"/>
        <!-- Contact shape of the Rad (r 20 mm, 5 mm wide); the mesh is drawn on top. -->
        <geom type="cylinder" size="0.02 0.0025" euler="1.5708 0 0" mass="0.005"
              friction="1.2 0.01 0.0001" rgba="0.16 0.16 0.18 0"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="plate" file="meshes/STL/Grundkörper.stl" scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="plate_mirrored" file="meshes/STL/Grundkörper.stl" scale="0.001 0.001 -0.001" inertia="exact"/>
    <mesh name="crank" file="meshes/STL/Antriebsstütze.stl" scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="linkage" file="meshes/STL/linkage.stl" scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="leg" file="meshes/STL/Bein.stl" scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="wheel" file="meshes/STL/Rad.stl" scale="0.001 0.001 0.001" inertia="exact"/>
  </asset>

  <worldbody>
    <body name="dog" childclass="dog" pos="0 0 0.2611">
      <freejoint name="root"/>
      <geom name="torso" type="box" size="0.2 0.09 0.07" mass="2.0"/>
      <site name="imu" pos="0 0 0" size="0.01"/>
      <!-- Ultrasonic sensor on the chest, looking forwards (a rangefinder measures along +z of its site). -->
      <site name="sonar" pos="0.201 0 -0.035" zaxis="1 0 0" size="0.008"/>
      <geom name="sonar_left" class="visual" type="cylinder" size="0.012 0.004" pos="0.203 0.025 -0.035" zaxis="1 0 0" rgba="0.75 0.77 0.8 1"/>
      <geom name="sonar_right" class="visual" type="cylinder" size="0.012 0.004" pos="0.203 -0.025 -0.035" zaxis="1 0 0" rgba="0.75 0.77 0.8 1"/>
      <geom name="emergency_stop" class="visual" type="cylinder" size="0.022 0.008" pos="0.02 0 0.075" rgba="0.85 0.12 0.1 1"/>
      <geom name="speaker" class="visual" type="cylinder" size="0.03 0.003" pos="0.12 0.091 0" zaxis="0 1 0" rgba="0.3 0.3 0.32 1"/>

      <body name="head" pos="0.19 0 0.07">
        <joint name="neck" type="hinge" axis="0 0 1" range="-0.8 0.8" damping="0.05"/>
        <geom name="neck" type="capsule" fromto="0 0 0 0.04 0 0.04" size="0.025" mass="0.05"/>
        <geom name="skull" type="box" size="0.06 0.05 0.045" pos="0.07 0 0.06" mass="0.2"/>
        <geom name="snout" type="box" size="0.035 0.035 0.025" pos="0.15 0 0.04" mass="0.03"/>
        <geom name="nose" class="visual" type="sphere" size="0.012" pos="0.186 0 0.05" rgba="0.1 0.1 0.1 1"/>
        <geom name="ear_left" class="visual" type="capsule" fromto="0.05 0.035 0.1 0.03 0.06 0.14" size="0.01"/>
        <geom name="ear_right" class="visual" type="capsule" fromto="0.05 -0.035 0.1 0.03 -0.06 0.14" size="0.01"/>
        <geom name="eye_left" class="visual" type="sphere" size="0.008" pos="0.128 0.03 0.08" rgba="0.08 0.08 0.1 1"/>
        <geom name="eye_right" class="visual" type="sphere" size="0.008" pos="0.128 -0.03 0.08" rgba="0.08 0.08 0.1 1"/>
        <!-- Camera module on top of the snout. In an eye socket the snout would hide a quarter of the image. -->
        <geom name="camera_lens" class="visual" type="cylinder" size="0.009 0.004" pos="0.17 0 0.068" zaxis="1 0 -0.36" rgba="0.05 0.2 0.35 1"/>
        <geom name="led_matrix" class="visual" type="box" size="0.03 0.001 0.02" pos="0.07 0.0505 0.06" rgba="0.1 0.45 0.25 1"/>
        <!-- Raspberry Pi camera v2: 62 x 49 degree field of view, tilted 20 degrees down so the
             floor close to the dog is in view (straight ahead it would miss the first 1.2 m).
             A MuJoCo camera looks along -z; xyaxes gives image right and image up. -->
        <camera name="eye" pos="0.175 0 0.07" xyaxes="0 -1 0 0.342 0 0.94" fovy="48.8"/>
      </body>

      <body name="tail" pos="-0.2 0 0.06">
        <joint name="tail" type="hinge" axis="0 0 1" range="-0.9 0.9" damping="0.01"/>
        <geom name="tail" type="capsule" fromto="0 0 0 -0.05 0 0.12" size="0.012" mass="0.03"/>
      </body>

      <!-- legs:begin (generated by apps/sim-host/scripts/build_legs.py; edit that, not this) -->
      <geom name="plate_front_left" class="part" mesh="plate_mirrored" pos="0.15757 0.1 -0.083424" quat="0.69712 0.69712 -0.11843 0.11843"/>
      <body name="crank_front_left" pos="0.088955 0.12 -0.081104">
        <joint name="servo_front_left" class="servo" axis="0 -1 0"/>
        <geom name="crank_front_left" class="part" mesh="crank" pos="0 -0.004 0" quat="-0.24184 0.24184 0.66446 0.66446"/>
        <site name="crank_end_front_left" pos="0.082273 0 -0.069035"/>
      </body>
      <body name="linkage_front_left" pos="0.1 0.12 -0.04">
        <joint name="hip_front_left" class="pin"/>
        <geom name="linkage_front_left" class="part" mesh="linkage" pos="0 -0.007 0" quat="-0.25846 0.25846 0.65818 0.65818"/>
        <site name="spring_link_front_left" pos="0.04156 0 -0.033132"/>
        <body name="leg_front_left" pos="0.071228 0 -0.066139">
          <joint name="knee_front_left" class="knee"/>
          <geom name="leg_front_left" class="part" mesh="leg" pos="0.0075 0.004 0.025" quat="0.5 -0.5 0.5 0.5"/>
          <site name="leg_attach_front_left" pos="0 0 -0.044"/>
          <site name="spring_leg_front_left" pos="0.0035 0 0.025"/>
          <body name="wheel_left" pos="0 0 -0.135">
            <joint name="wheel_left" class="wheel"/>
            <geom name="wheel_left" class="wheel" pos="0 0.0175 0"/>
            <geom name="rad_front_left" class="part" mesh="wheel" pos="0 0.015 0" quat="0.70711 -0.70711 0 0"/>
          </body>
        </body>
      </body>
      <geom name="plate_front_right" class="part" mesh="plate" pos="0.15757 -0.1 -0.083424" quat="0.69712 0.69712 -0.11843 0.11843"/>
      <body name="crank_front_right" pos="0.088955 -0.12 -0.081104">
        <joint name="servo_front_right" class="servo" axis="0 -1 0"/>
        <geom name="crank_front_right" class="part" mesh="crank" pos="0 0.004 0" quat="0.24184 0.24184 -0.66446 0.66446"/>
        <site name="crank_end_front_right" pos="0.082273 0 -0.069035"/>
      </body>
      <body name="linkage_front_right" pos="0.1 -0.12 -0.04">
        <joint name="hip_front_right" class="pin"/>
        <geom name="linkage_front_right" class="part" mesh="linkage" pos="0 0.007 0" quat="0.25846 0.25846 -0.65818 0.65818"/>
        <site name="spring_link_front_right" pos="0.036117 0 -0.038995"/>
        <body name="leg_front_right" pos="0.071228 0 -0.066139">
          <joint name="knee_front_right" class="knee"/>
          <geom name="leg_front_right" class="part" mesh="leg" pos="-0.0075 -0.004 0.025" quat="-0.5 -0.5 -0.5 0.5"/>
          <site name="leg_attach_front_right" pos="0 0 -0.044"/>
          <site name="spring_leg_front_right" pos="-0.0035 0 0.025"/>
          <body name="wheel_right" pos="0 0 -0.135">
            <joint name="wheel_right" class="wheel"/>
            <geom name="wheel_right" class="wheel" pos="0 -0.0175 0"/>
            <geom name="rad_front_right" class="part" mesh="wheel" pos="0 -0.015 0" quat="0.70711 0.70711 0 0"/>
          </body>
        </body>
      </body>
      <geom name="plate_rear_left" class="part" mesh="plate" pos="-0.15757 0.1 -0.083424" quat="-0.11843 0.11843 0.69712 0.69712"/>
      <body name="crank_rear_left" pos="-0.088955 0.12 -0.081104">
        <joint name="servo_rear_left" class="servo" axis="0 1 0"/>
        <geom name="crank_rear_left" class="part" mesh="crank" pos="0 -0.004 0" quat="0.66446 -0.66446 -0.24184 -0.24184"/>
        <site name="crank_end_rear_left" pos="-0.082273 0 -0.069035"/>
      </body>
      <body name="linkage_rear_left" pos="-0.1 0.12 -0.04">
        <joint name="hip_rear_left" class="pin"/>
        <geom name="linkage_rear_left" class="part" mesh="linkage" pos="0 -0.007 0" quat="0.65818 -0.65818 -0.25846 -0.25846"/>
        <site name="spring_link_rear_left" pos="-0.036117 0 -0.038995"/>
        <body name="leg_rear_left" pos="-0.071228 0 -0.066139">
          <joint name="knee_rear_left" class="knee"/>
          <geom name="leg_rear_left" class="part" mesh="leg" pos="0.0075 0.004 0.025" quat="0.5 -0.5 0.5 0.5"/>
          <site name="leg_attach_rear_left" pos="0 0 -0.044"/>
          <site name="spring_leg_rear_left" pos="0.0035 0 0.025"/>
          <geom name="caster_rear_left" class="caster" pos="0 0.0175 -0.135"/>
          <geom name="rad_rear_left" class="part" mesh="wheel" pos="0 0.015 -0.135" quat="0.70711 -0.70711 0 0"/>
        </body>
      </body>
      <geom name="plate_rear_right" class="part" mesh="plate_mirrored" pos="-0.15757 -0.1 -0.083424" quat="-0.11843 0.11843 0.69712 0.69712"/>
      <body name="crank_rear_right" pos="-0.088955 -0.12 -0.081104">
        <joint name="servo_rear_right" class="servo" axis="0 1 0"/>
        <geom name="crank_rear_right" class="part" mesh="crank" pos="0 0.004 0" quat="0.66446 0.66446 -0.24184 0.24184"/>
        <site name="crank_end_rear_right" pos="-0.082273 0 -0.069035"/>
      </body>
      <body name="linkage_rear_right" pos="-0.1 -0.12 -0.04">
        <joint name="hip_rear_right" class="pin"/>
        <geom name="linkage_rear_right" class="part" mesh="linkage" pos="0 0.007 0" quat="0.65818 0.65818 -0.25846 0.25846"/>
        <site name="spring_link_rear_right" pos="-0.04156 0 -0.033132"/>
        <body name="leg_rear_right" pos="-0.071228 0 -0.066139">
          <joint name="knee_rear_right" class="knee"/>
          <geom name="leg_rear_right" class="part" mesh="leg" pos="-0.0075 -0.004 0.025" quat="-0.5 -0.5 -0.5 0.5"/>
          <site name="leg_attach_rear_right" pos="0 0 -0.044"/>
          <site name="spring_leg_rear_right" pos="-0.0035 0 0.025"/>
          <geom name="caster_rear_right" class="caster" pos="0 -0.0175 -0.135"/>
          <geom name="rad_rear_right" class="part" mesh="wheel" pos="0 -0.015 -0.135" quat="0.70711 0.70711 0 0"/>
        </body>
      </body>
      <!-- legs:end -->
    </body>
  </worldbody>

  <equality>
    <!-- Close each four-bar: the end of the drive strut is pinned to the leg. A stiffer
         solref than the default keeps the pin within a fraction of a millimetre. -->
    <connect site1="crank_end_front_left" site2="leg_attach_front_left" solref="0.005 1"/>
    <connect site1="crank_end_front_right" site2="leg_attach_front_right" solref="0.005 1"/>
    <connect site1="crank_end_rear_left" site2="leg_attach_rear_left" solref="0.005 1"/>
    <connect site1="crank_end_rear_right" site2="leg_attach_rear_right" solref="0.005 1"/>
  </equality>

  <tendon>
    <!-- Tension springs: pull only once stretched past the first springlength value's band
         (force = 150 N/m * (length - 0.14 m) when longer, nothing when shorter).
         Tuned so the servos hold about 0.2 Nm standing instead of 0.5 Nm. -->
    <spatial name="spring_front_left" stiffness="600" springlength="0 0.02" width="0.003" rgba="0.85 0.75 0.3 1">
      <site site="spring_link_front_left"/><site site="spring_leg_front_left"/>
    </spatial>
    <spatial name="spring_front_right" stiffness="600" springlength="0 0.02" width="0.003" rgba="0.85 0.75 0.3 1">
      <site site="spring_link_front_right"/><site site="spring_leg_front_right"/>
    </spatial>
    <spatial name="spring_rear_left" stiffness="600" springlength="0 0.02" width="0.003" rgba="0.85 0.75 0.3 1">
      <site site="spring_link_rear_left"/><site site="spring_leg_rear_left"/>
    </spatial>
    <spatial name="spring_rear_right" stiffness="600" springlength="0 0.02" width="0.003" rgba="0.85 0.75 0.3 1">
      <site site="spring_link_rear_right"/><site site="spring_leg_rear_right"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="hip_front_left" joint="servo_front_left" class="servo"/>
    <position name="hip_front_right" joint="servo_front_right" class="servo"/>
    <position name="hip_rear_left" joint="servo_rear_left" class="servo"/>
    <position name="hip_rear_right" joint="servo_rear_right" class="servo"/>
    <position name="neck" joint="neck" kp="3" forcerange="-0.4 0.4" ctrlrange="-0.8 0.8"/>
    <position name="tail" joint="tail" kp="1" forcerange="-0.2 0.2" ctrlrange="-0.9 0.9"/>
    <velocity name="wheel_left" joint="wheel_left" class="wheel"/>
    <velocity name="wheel_right" joint="wheel_right" class="wheel"/>
  </actuator>

  <sensor>
    <jointpos name="encoder_left" joint="wheel_left"/>
    <jointpos name="encoder_right" joint="wheel_right"/>
    <framequat name="imu_orientation" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
    <rangefinder name="sonar" site="sonar"/>
  </sensor>
</mujoco>

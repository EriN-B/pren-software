[importlinter]
# Only what the root environment installs. apps/robot (dog_core, dog_perception,
# dog_recorder) has its own environment; its import rules would run there.
root_packages =
    dog_protocol
    dog_sim_host
include_external_packages = True

[importlinter:contract:protocol-standalone]
name = dog_protocol does not import the simulator host
type = forbidden
source_modules = dog_protocol
forbidden_modules =
    dog_sim_host
